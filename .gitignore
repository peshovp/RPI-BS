*.pyc
*~
rtkrcv.nav
.vscode/*
/logs/*
settings.conf
/data/*
/log/*
test.sh
test.conf
# Exception to the test.sh rule above: PRIDE-PPPAR's own vendored install.sh
# (addons/PRIDE-PPPAR/install.sh) requires example/test.sh to exist (it globs
# `./example/*.sh` unconditionally, before the non-interactive "run tests?"
# prompt is even answered) - this is the upstream test harness entry point,
# not this project's own test.sh convention the blanket rule above targets.
!/addons/PRIDE-PPPAR/example/test.sh
*.FCStd1
**/venv*/*
**/build/
/rtkbase
.continue/
# GeoMaxima runtime data written inside the checkout on stations (by the
# root web service or the OTA updater). Ignored so an OTA leaves `git
# status` clean; ownership is normalized by the updater before every
# reset (tools/repo_update.sh).
/geomaxima_survey/
/geomaxima_geoid/
/geomaxima_ppp/
/archives/
# Legacy OTA runtime files - moved to /var/lib/rtkbase/ota by the updater
# controller on first start; ignored until then.
/.update_status.json
/.github_token
/.git_askpass.sh
# Confirmed-live debris from a manual diagnostic curl/wget command run
# directly in the checkout (an FTP directory listing redirected to a file
# literally named "wum") - no code in this repo creates this; ignored
# purely as a safety net in case it recurs during manual debugging.
/wum
# 2026-10-13 review fix: settings.conf backups now live at
# /var/lib/rtkbase/settings_backups (RTKBaseConfigManager.py), never
# inside this checkout - this is a safety net against the OLD in-repo
# location ever being re-created (e.g. by a station still running pre-
# migration code) and then caught up in a `git reset --hard`/`git clean`.
/settings_conf_backups/
