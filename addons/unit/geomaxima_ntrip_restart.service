[Unit]
Description=GeoMaxima Periodic NTRIP Caster Connection Restart (stopgap for stale/half-open TCP sessions)
Documentation=https://github.com/peshovp/GeoMaxima-BS

[Service]
Type=oneshot
User=root
# Restarts str2str_ntrip_A/B unconditionally, on a timer - see
# geomaxima_ntrip_restart.timer for the interval and rationale. This is a
# stopgap, not a real fix: a manual restart of these services has been
# confirmed to reliably clear the "base station disappears from the NTRIP
# caster after several hours with no rover connected" symptom, most likely
# because str2str's ntrips:// output has no application-level keepalive and
# does not reliably detect a half-open TCP session the caster has silently
# dropped its side of. Forcing a periodic reconnect bounds how long that
# stale-session window can last, without needing to know the caster's exact
# idle-timeout behavior. Only restarts services that are actually active -
# a station not currently using ntrip A/B is left untouched.
ExecStart=/bin/sh -c '\
  systemctl is-active --quiet str2str_ntrip_A.service && systemctl restart str2str_ntrip_A.service; \
  systemctl is-active --quiet str2str_ntrip_B.service && systemctl restart str2str_ntrip_B.service; \
  true'
StandardOutput=journal
StandardError=journal

# Restart policy
Restart=no

[Install]
WantedBy=multi-user.target
